{
  "name": "kora",
  "version": "1.0.0",
  "description": "Kora - AI Desktop Assistant: local-first Electron app with an LLM chat and a ReAct agent that works with files, shell, web and system, plus MCP tool support.",
  "license": "MIT",
  "author": "mineones047-ux",
  "repository": {
    "type": "git",
    "url": "https://github.com/mineones047-ux/KoraDesctop.git"
  },
  "homepage": "https://github.com/mineones047-ux/KoraDesctop#readme",
  "keywords": [
    "ai",
    "assistant",
    "electron",
    "react",
    "typescript",
    "llm",
    "react-agent",
    "mcp",
    "lm-studio",
    "ollama"
  ],
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "build:main": "node scripts/build-main.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.cjs",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "msedge-tts": "^2.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "@modelcontextprotocol/server-memory": "^2026.8.31",
    "@modelcontextprotocol/server-sequential-thinking": "^2026.8.31",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^25.0.5",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.45",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.kora.assistant",
    "productName": "Kora",
    "afterPack": "scripts/after-pack.cjs",
    "asar": true,
    "asarUnpack": [
      "dist-electron/mcp/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis",
      "icon": "build-assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kora-Setup-${version}.${ext}"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "msedge-tts": false
  }
}
